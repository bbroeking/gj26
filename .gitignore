# macOS
.DS_Store

# Editor / agent state
.claude/
.codex/

# Independently versioned companion sites (nested repositories)
codex/
companion-site/

# Backups + research GLB iterations (not used by the game; keep repo lean)
models/*.bak
models/*_r[0-9][0-9][0-9]_*.glb
models/cook_v30.glb.bak
*.blend1

# Raw Meshy downloads and generated rig exports. Production GLBs, source
# scripts, delivery receipts, and selected Blender authoring files are tracked.
models/meshy_staging/
models/cow_old.glb.bak

# Eldra autoresearch outputs (huge GLB iterations + symlinks pointing
# to model files we exclude above — keep entire runs/ dir out of git).
docs/research/eldra/*.glb
docs/research/eldra/runs/

# Secrets — never commit API keys
.env

# Godot caches + export artifacts (godot/ = evaluation project, wyrd/ = the game)
godot/.godot/
godot/build/
wyrd/.godot/
wyrd/build/

# Generated / temp
*.log
*.tmp
node_modules/
tmp/

# Python bytecode
__pycache__/
*.pyc
.claudecraft-ref/
