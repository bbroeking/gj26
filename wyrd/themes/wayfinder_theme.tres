SystemTextEdit/colors/font_placeholder_color = Color(0.427451, 0.34902, 0.270588, 0.8)
SystemTextEdit/colors/font_readonly_color = Color(0.427451, 0.34902, 0.270588, 1)
SystemTextEdit/font_sizes/font_size = 16
SystemTextEdit/styles/normal = SubResource("PaperRaised")
SystemTextEdit/styles/focus = SubResource("SystemLineFocus")
SystemTextEdit/styles/read_only = SubResource("PaperRaised")
TabButton/base_type = &"Button"
TabButton/styles/normal = SubResource("ButtonNormal")
TabButton/styles/hover = SubResource("ButtonHover")
TabButton/styles/pressed = SubResource("SelectedTabTexture")
TabButton/styles/disabled = SubResource("ButtonDisabled")
TabButton/styles/focus = SubResource("FocusRing")
TabButton/styles/hover_pressed = SubResource("SelectedTabTexture")
TabButton/styles/pressed_mirrored = SubResource("SelectedTabTexture")
